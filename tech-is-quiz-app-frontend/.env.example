# URL of the backend API (baked in at build time, so redeploy after changing it)
NEXT_PUBLIC_API_URL=http://localhost:4100
# Must be exactly the same random secret as the backend
AUTH_SECRET=replace-with-the-same-random-secret-as-the-backend
# Optional. Not needed when the API and website are on different domains (the website sends a Bearer token).
# COOKIE_DOMAIN=.example.com
